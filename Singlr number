#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter the number of elements: ";
    cin >> n;

    int arr[n];

    cout << "Enter the elements: ";
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int result = 0;

    for(int i = 0; i < n; i++) {
        result ^= arr[i];
    }

    cout << "The single element is: " << result;

    return 0;
}
