#include <iostream>
using namespace std;

struct Activity {
    int start;
    int finish;
};

int main() {
    int n;
    cin >> n;

    Activity a[100];

    for (int i = 0; i < n; i++)
        cin >> a[i].start >> a[i].finish;

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i].finish > a[j].finish) {
                Activity temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    cout << "Selected activities: ";

    int lastFinish = -1;

    for (int i = 0; i < n; i++) {
        if (a[i].start >= lastFinish) {
            cout << "(" << a[i].start << "," << a[i].finish << ") ";
            lastFinish = a[i].finish;
        }
    }

    return 0;
}
