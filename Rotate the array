#include <iostream>
using namespace std;

int main() {
    int n, k;

    cout << "Enter the number of elements: ";
    cin >> n;

    int arr[n];

    cout << "Enter the array elements: ";
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter the value of k: ";
    cin >> k;

    k = k % n;

    int temp[n];

    for(int i = 0; i < n; i++) {
        temp[(i + k) % n] = arr[i];
    }

    cout << "Array after rotation: ";
    for(int i = 0; i < n; i++) {
        cout << temp[i] << " ";
    }

    return 0;
}
