#include <iostream>
#include <vector>
#include <queue>
#include <algorithm>
using namespace std;

struct Item {
    int weight, value;
    double ratio;
};

struct Node {
    int level, weight, value;
    double bound;
};

vector<Item> items;
int n, W;
double calculateBound(Node u) {
    if (u.weight > W)
        return 0;

    double profitBound = u.value;
    int totalWeight = u.weight;
    int j = u.level + 1;

    while (j < n &&
           totalWeight + items[j].weight <= W) {
        totalWeight += items[j].weight;
        profitBound += items[j].value;
        j++;
    }

    if (j < n)
        profitBound += (W - totalWeight) *
                       items[j].ratio;

    return profitBound;
}

int knapsack() {
    sort(items.begin(), items.end(),
         [](const Item& a, const Item& b) {
             return a.ratio > b.ratio;
         });

    priority_queue<pair<double, Node>,
                   vector<pair<double, Node>>,
                   function<bool(pair<double, Node>,
                                 pair<double, Node>)>> pq(
        [](const auto& a, const auto& b) {
            return a.first < b.first;
        });

    Node root = {-1, 0, 0, 0};
    root.bound = calculateBound(root);
    pq.push({root.bound, root});

    int maxProfit = 0;

    while (!pq.empty()) {
        Node u = pq.top().second;
        pq.pop();

        if (u.bound <= maxProfit)
            continue;

        if (u.level == n - 1)
            continue;

        int next = u.level + 1;
        Node include = {
            next,
            u.weight + items[next].weight,
            u.value + items[next].value,
            0
        };

        if (include.weight <= W) {
            maxProfit = max(maxProfit, include.value);

            include.bound = calculateBound(include);

            if (include.bound > maxProfit)
                pq.push({include.bound, include});
        }
        Node exclude = {
            next, u.weight, u.value, 0
        };

        exclude.bound = calculateBound(exclude);

        if (exclude.bound > maxProfit)
            pq.push({exclude.bound, exclude});
    }

    return maxProfit;
}

int main() {
    cin >> n >> W;

    if (n < 0 || W < 0) {
        cout << "Invalid input\n";
        return 0;
    }

    items.resize(n);

    for (int i = 0; i < n; i++) {
        cin >> items[i].weight >> items[i].value;

        if (items[i].weight <= 0 ||
            items[i].value < 0) {
            cout << "Invalid item\n";
            return 0;
        }

        items[i].ratio =
            (double)items[i].value / items[i].weight;
    }

    cout << "Maximum value: " << knapsack() << '\n';

    return 0;
}
