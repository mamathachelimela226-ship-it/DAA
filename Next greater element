#include <iostream>
#include <stack>
using namespace std;

int main() {
    int n, a[100];
    cin >> n;

    for (int i = 0; i < n; i++)
        cin >> a[i];

    stack<int> s;
    int result[100];

    for (int i = n - 1; i >= 0; i--) {
        while (!s.empty() && s.top() <= a[i])
            s.pop();

        if (s.empty())
            result[i] = -1;
        else
            result[i] = s.top();

        s.push(a[i]);
    }

    for (int i = 0; i < n; i++)
        cout << result[i] << " ";

    return 0;
}
